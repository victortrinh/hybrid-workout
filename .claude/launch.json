{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "prototype"],
      "port": 4173
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "app-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mock", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
