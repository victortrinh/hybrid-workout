{
  "name": "compromised",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm test && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply compromised --local",
    "db:migrate:prod": "wrangler d1 migrations apply compromised --remote",
    "db:migrate:preview": "wrangler d1 migrations apply compromised-preview --remote --config wrangler.preview-db.jsonc",
    "check:access": "node scripts/check-access.mjs",
    "check": "tsc -b",
    "check:no-mocks": "node scripts/check-no-mocks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
    "sql.js": "^1.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
