{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compromised",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Production lives on the free compromised.<subdomain>.workers.dev address,
  // behind Cloudflare Access (ADR-0001, docs/deploy.md). Per-version preview
  // URLs are off: they are separate hostnames the Access application would not
  // cover.
  "workers_dev": true,
  "preview_urls": false,
  // The Worker serves the built SPA. Anything that isn't a file falls back to
  // index.html so /plan and /progress load on refresh; /api/* always reaches Hono.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compromised",
      // Production database (docs/deploy.md, step 2). The id is not a secret:
      // it only works with credentials for Victor's Cloudflare account.
      "database_id": "a2776333-114c-4317-a444-af71a518457f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
