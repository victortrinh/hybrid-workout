{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compromised",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Production lives on the free compromised.<subdomain>.workers.dev address,
  // behind Cloudflare Access (ADR-0001, docs/deploy.md). Branch previews get
  // their own *-compromised.<subdomain>.workers.dev hostnames, which need Access
  // too (docs/deploy.md, "Preview URLs").
  "workers_dev": true,
  "preview_urls": true,
  // The Worker serves the built SPA. Anything that isn't a file falls back to
  // index.html so /plan and /progress load on refresh; /api/* always reaches Hono.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compromised",
      // Production database (docs/deploy.md, step 2). The id is not a secret:
      // it only works with credentials for Victor's Cloudflare account.
      "database_id": "a2776333-114c-4317-a444-af71a518457f",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access's team domain: the Worker checks Access's signed
  // assertion for the recovery Shortcut's service token against its keys
  // (src/worker/access.ts). Not a secret: it's the login page's address.
  "vars": { "ACCESS_TEAM_DOMAIN": "https://quiet-shape-374b.cloudflareaccess.com" },
  // Branch builds (Workers Builds on a PR) are mock builds (VITE_API=mock,
  // docs/deploy.md): /api/* is answered in the browser, so previews get no D1
  // at all and PR code never touches real Session logs. Previews inherit no
  // bindings or vars, and Wrangler refuses to upload one without this block.
  "previews": {
    "vars": { "ACCESS_TEAM_DOMAIN": "https://quiet-shape-374b.cloudflareaccess.com" }
  },
  "observability": { "enabled": true }
}
