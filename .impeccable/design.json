      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-row{display:flex;gap:20px}.ds-link{background:none;border:0;cursor:pointer;color:var(--link);font:700 15px Archivo,system-ui,sans-serif;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px;padding:8px 0}.ds-link:hover{text-decoration-thickness:3px}.ds-quiet{color:var(--ink);text-decoration:none}.ds-link:focus-visible{outline:3px solid var(--link);outline-offset:2px}"
