      "html": "<button class=\"ds-btn ds-btn-primary\">Start session</button>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-btn{min-height:54px;border-radius:var(--radius);display:inline-grid;place-items:center;font:700 17px Archivo,system-ui,sans-serif;padding:0 20px;border:0;cursor:pointer}.ds-btn-primary{background:var(--cobalt);color:#fff}.ds-btn-primary:hover{background:var(--cobalt-hover)}.ds-btn:focus-visible{outline:3px solid var(--link);outline-offset:2px}"
