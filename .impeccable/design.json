      "description": "Desktop cobalt side rail; active item inverts to white.",
      "html": "<nav class=\"ds-side\"><span class=\"ds-brand\">COMPROMISED</span><a href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 8h18M3 12h18M3 16h18\"/></svg>Today</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"1\"/><path d=\"M4 10h16M10 4v16\"/></svg>Plan</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 19V5M4 19h16M8 15l4-4 3 3 5-6\"/></svg>Progress</a></nav>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-side{display:grid;gap:4px;width:240px;background:var(--cobalt);color:#fff;padding:28px 24px}.ds-brand{font-weight:800;font-stretch:125%;font-size:20px;letter-spacing:.02em;margin-bottom:32px}.ds-side a{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none;font-weight:700;font-size:17px;padding:10px 12px;border-radius:var(--radius)}.ds-side a:hover{background:rgba(255,255,255,.12)}.ds-side a[aria-current=\"page\"]{background:#fff;color:var(--cobalt)}.ds-side a:focus-visible{outline:3px solid #fff;outline-offset:2px}.ds-side svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Field Band with Striped Numeral",
      "kind": "custom",
      "refersTo": "field-band",
      "description": "Cobalt countdown band: striped hero numeral and five Phase lanes. Stripe phase is computed at runtime from glyph ascent; values here are a static approximation.",
      "html": "<header class=\"ds-field\"><div class=\"ds-num\">168</div><p class=\"ds-cap\">days to the race · Wed 21 April</p><div class=\"ds-lanes\"><div class=\"ds-ph cur\"><span>Foundation</span><span class=\"ds-lane\"><i style=\"width:42%\"></i></span></div><div class=\"ds-ph\"><span>5K development</span><span class=\"ds-lane\"><i></i></span></div><div class=\"ds-ph\"><span>HYROX build</span><span class=\"ds-lane\"><i></i></span></div><div class=\"ds-ph\"><span>Race specific</span><span class=\"ds-lane\"><i></i></span></div><div class=\"ds-ph\"><span>Taper</span><span class=\"ds-lane\"><i></i></span></div></div></header>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-field{background:var(--cobalt);color:#fff;padding:16px 20px 20px}.ds-num{position:relative;display:inline-block;font-size:150px;font-weight:900;font-stretch:125%;letter-spacing:-.04em;line-height:.88}.ds-num::after{content:\"\";position:absolute;left:-2px;right:-2px;top:6%;height:72%;background:repeating-linear-gradient(to bottom,transparent 0 12.8px,var(--cobalt) 12.8px 17.3px)}.ds-cap{font-size:18px;font-weight:600;margin:10px 0 0}.ds-lanes{display:grid;gap:6px;margin-top:18px}.ds-ph{display:grid;grid-template-columns:128px 1fr;gap:10px;align-items:center;font-size:13px;font-weight:600}.ds-ph.cur{font-weight:800}.ds-lane{position:relative;height:5px;background:var(--cobalt-soft);overflow:hidden}.ds-ph.cur .ds-lane{height:8px}.ds-lane i{position:absolute;inset:0 auto 0 0;background:#fff;width:0;transition:width .9s cubic-bezier(.16,1,.3,1)}"
    },
    {
      "name": "Live Block Lanes",
      "kind": "custom",
      "refersTo": "lane-track-paper",
      "description": "One lane per block in a treadmill Live session, coloured by Session type; the current block grows.",
      "html": "<div class=\"ds-lv\"><div class=\"ds-l\"><span>Warm-up</span><span class=\"t\">10 min</span><span class=\"bar\" style=\"--c:var(--easy)\"><i style=\"width:100%\"></i></span></div><div class=\"ds-l cur\"><span>Rep 1</span><span class=\"t\">12.2 km/h</span><span class=\"bar\" style=\"--c:var(--thr)\"><i style=\"width:52%\"></i></span></div><div class=\"ds-l\"><span>Jog</span><span class=\"t\">2 min</span><span class=\"bar\" style=\"--c:var(--easy)\"><i></i></span></div></div>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-lv{display:grid;gap:12px;color:var(--ink)}.ds-l{display:grid;grid-template-columns:1fr auto;gap:6px 10px;font-size:15px;font-weight:600}.ds-l .t{color:var(--muted)}.ds-l .bar{grid-column:1/-1;height:12px;background:var(--rule);position:relative;overflow:hidden}.ds-l .bar i{position:absolute;inset:0 auto 0 0;width:0;background:var(--c)}.ds-l.cur{font-size:17px;font-weight:800}.ds-l.cur .bar{height:26px}"
    },
    {
      "name": "Week Lane Row",
      "kind": "custom",
      "refersTo": "lane-track-paper",
      "description": "Plan and Weekly completion row: Week number, five Session-type cells (filled = done, tall = Key session), note.",
      "html": "<div class=\"ds-wk cur\"><span class=\"no\">03</span><span class=\"cells\"><i class=\"f\" style=\"--c:var(--speed)\"></i><i style=\"--c:var(--str)\"></i><i class=\"k\" style=\"--c:var(--thr)\"></i><i style=\"--c:var(--hyrox)\"></i><i style=\"--c:var(--easy)\"></i></span><span class=\"ph\">In progress</span></div>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-wk{display:grid;grid-template-columns:40px 1fr 88px;gap:10px;align-items:center;padding:7px 0;border-bottom:1px solid var(--rule);color:var(--ink)}.ds-wk .no{font-weight:800;font-stretch:125%}.ds-wk.cur{background:var(--sunk)}.ds-wk.cur .no{color:var(--link)}.ds-wk .cells{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.ds-wk .cells i{display:block;height:12px;box-shadow:inset 0 0 0 2px var(--c)}.ds-wk .cells i.f{background:var(--c)}.ds-wk .cells i.k{height:18px}.ds-wk .ph{font-size:13px;color:var(--muted);font-weight:600;text-align:right}"
    },
    {
      "name": "Ruled Panel",
      "kind": "card",
      "refersTo": "empty-state",
      "description": "Progress panel: no card, a 2px ink top rule; empty state is the one sunk block.",
      "html": "<section class=\"ds-panel\"><h2>HYROX stations</h2><p class=\"sub\">Times from Race simulations</p><div class=\"ds-empty\">No Race simulation yet. First one is Week 18, Feb 15. Enjoy the peace.</div></section>",
      "css": ":host{--cobalt:#1B3BB8;--cobalt-hover:#15309A;--cobalt-soft:rgba(255,255,255,.32);--paper:#FFFFFF;--sunk:#F4F5F8;--ink:#121212;--muted:#4D4F57;--rule:#E3E4E8;--edge:#6F727B;--link:#1B3BB8;--speed:#D9302A;--thr:#C76100;--hyrox:#1E8A3E;--str:#6A3FB5;--easy:#6A6E78;--good:#1E8A3E;--radius:4px;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-panel{border-top:2px solid var(--ink);padding:14px 0 24px;color:var(--ink)}.ds-panel h2{margin:0;font-size:26px;font-weight:850;font-stretch:75%;letter-spacing:-.01em;line-height:1.02}.ds-panel .sub{font-size:15px;color:var(--muted);margin:4px 0 0}.ds-empty{margin-top:12px;padding:18px;background:var(--sunk);border-radius:var(--radius);font-weight:600}"
    }
  ],
  "narrative": {
    "northStar": "Lanes '76",
    "overview": "Training run in lanes. The world borrows the Montréal 1976 Olympic identity: five parallel stripes, track lane lines, striped lettering. Progress is never a ring and never a card; it is parallel bars filling left to right, one lane per Phase, block, set group or Session type. A cobalt field owns the shell (countdown band, primary actions, active navigation, rest timer) and stays the same cobalt in light and dark themes; everything else sits on paper and is divided by ink rules.\n\nDensity is athletic: one big number, one instruction, then rows. Numbers are the heroes and are set expanded and black at 900 weight with horizontal stripes cut through them; headings are condensed and heavy; everything else is regular-width Archivo at 600. The surface is flat: rules, tonal sinks and fills do the structural work, not shadows or containers. The Coach's copy is blunt and dry, and every line carries the number and the reason.\n\nThe category default (rounded cards, progress rings, gradient hero, a single sporty neon accent) is the confirmed anti-reference.",
    "keyCharacteristics": [
      "Cobalt field band at the top of Today and every Live session, constant across themes.",
      "Striped numerals for the race countdown, the live target speed and the live target load.",
      "Five-lane progress everywhere progress is shown.",
      "Five Session-type lane colours that mean the same thing on every screen.",
      "2px ink rules and 1px hairlines instead of cards; square 4px corners.",
      "Underlined links, tabular figures throughout."
    ],
    "rules": [
      {
        "name": "The Constant Field Rule",
        "body": "Cobalt is the same in light and dark. Only paper-side tokens change with the theme; the field band, its white type and its lanes never do.",
        "section": "colors"
      },
      {
        "name": "The Lane Colour Rule",
        "body": "A Session-type colour means that Session type and nothing else. Never use `speed` red as a generic error or `hyrox` green as generic success outside the two shared status aliases.",
        "section": "colors"
      },
      {
        "name": "The Never Colour Alone Rule",
        "body": "Every lane colour is paired with a name (legend, row label, block label), and filled vs. outlined cells carry done vs. planned independently of hue.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Numbers that matter are expanded (width 125) at 900; headings are condensed (width 75) at 850; everything else is width 100. No third display width.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "`font-variant-numeric: tabular-nums` is set on the body; every figure in the product aligns in columns, including timers that tick.",
        "section": "typography"
      },
      {
        "name": "The Striped Numeral Rule",
        "body": "Striped numerals are reserved for the single hero number of a screen (countdown, live target speed, live target load). Stripes are phased from the glyph's cap top to the baseline so whole bands land on both edges; the stripe colour is the surface colour (cobalt on the field); the decimal point stays solid above the stripes.",
        "section": "typography"
      },
      {
        "name": "The One Answer Rule",
        "body": "Each screen opens with one hero number or one instruction in the first viewport; everything else follows as rows.",
        "section": "layout"
      },
      {
        "name": "The Rule-Not-Card Rule",
        "body": "Content groups are separated by a 2px ink top rule (panels, the Suggestion, the held-pace check, the tab bar) and 1px hairlines between rows. No bordered or shadowed cards on paper.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show progress as parallel lanes filling left to right (5px on the field, 12px on paper, 26px for the live current block).",
      "Do keep cobalt (`#1B3BB8`) constant across light and dark themes; theme only the paper side.",
      "Do stripe only the screen's hero number, phased top to baseline, with a solid decimal point.",
      "Do separate groups with a 2px ink rule and rows with a 1px `rule` hairline.",
      "Do use 4px corners on controls and square ends on lanes, cells and bars.",
      "Do underline links (2px at 4px offset) and keep tabular figures everywhere.",
      "Do pair every lane colour with its Session-type name.",
      "Do write Coach lines that state the number and the reason first, the joke second (\"Slept 5 h 41. Bold strategy. Reps cut to 2 × 10′.\")."
    ],
    "donts": [
      "Don't use progress rings, donut charts or pill-shaped progress bars.",
      "Don't put content in bordered or shadowed cards; the popover is the only floating, shadowed surface.",
      "Don't reuse a Session-type colour for anything other than its Session type.",
      "Don't add a second accent hue to the shell, or gradients to the field.",
      "Don't stripe body figures, timers or table values; they stay solid.",
      "Don't set display type at a third width or in a different family.",
      "Don't write cheerleading or motivational-poster copy, or a joke that hides the instruction."
    ]
  }
}
